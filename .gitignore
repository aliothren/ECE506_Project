# Reproducible tool outputs and local caches
__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
.Xil/
*.jou
*.log
/runs/
/results/ffn_cpu*
/results/environment.json
/results/local_cpu_smoke*
/results/interface_validation.json
/report/*.aux
/report/*.log
/report/*.out
/report/*.toc
/report/*.pdf
/figures/*.pdf

# Deployment packages and manifest records.
/deploy/*
!/deploy/README.md
!/deploy/*_release1.zip
!/deploy/*_release1/
/deploy/*_release1/*
!/deploy/*_release1/manifest.json

# Retain final board evidence, including logs needed for hash verification.
/results/board2_20261118/*
